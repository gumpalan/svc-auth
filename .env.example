# Konfigurasi Database Gumpalan Auth Service
# Pilihan: sqlite | mysql | mariadb | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=./data/auth.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=disable
DB_URL=
DB_AUTO_MIGRATE=true

# Contoh untuk MariaDB / MySQL:
# DB_CONNECTION=mariadb
# DB_DATABASE=gumpalan_auth
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=gumpalan
# DB_PASSWORD=secret

# Contoh untuk PostgreSQL:
# DB_CONNECTION=pgsql
# DB_DATABASE=gumpalan_auth
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=gumpalan
# DB_PASSWORD=secret
# DB_SSLMODE=disable

# Konfigurasi Server
PORT=8001
